#!/usr/bin/env python3
"""Stand-in for the gh command, with made-up data, for tests."""
import datetime as dt
import json
import sys

args = " ".join(sys.argv[1:])
if sys.argv[1:3] == ["auth", "status"]:
    sys.exit(0)
if sys.argv[1:3] == ["api", "user"]:
    print("octocat")
    sys.exit(0)
if "viewer" in args:
    repo = {"name": "hello-world", "isPrivate": False, "stargazerCount": 42,
            "primaryLanguage": {"name": "Python", "color": "#3572A5"}}
    data = {"viewer": {"login": "octocat", "repositories": {
        "totalCount": 1, "pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": [repo]}}}
elif "committedDate" in args:
    now = dt.datetime.now(dt.timezone.utc)
    nodes = [{"committedDate": (now - dt.timedelta(days=d)).strftime("%Y-%m-%dT%H:%M:%SZ")}
             for d in (1, 1, 1, 4, 9, 9, 15, 22, 22, 22, 22)]
    data = {"repository": {"defaultBranchRef": {"target": {"history": {
        "pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": nodes}}}}}
else:
    data = {"repository": {
        "name": "hello-world", "url": "https://github.com/octocat/hello-world", "isPrivate": False,
        "stargazerCount": 42, "forkCount": 7, "pushedAt": "2026-01-01T00:00:00Z",
        "defaultBranchRef": {"name": "main", "target": {"history": {"totalCount": 128}}},
        "refs": {"totalCount": 3},
        "languages": {"totalSize": 100, "edges": [
            {"size": 80, "node": {"name": "Python", "color": "#3572A5"}},
            {"size": 20, "node": {"name": "HTML", "color": "#e34c26"}}]},
        "pullRequests": {"nodes": [{
            "number": 12, "title": "Add feature", "url": "https://github.com/octocat/hello-world/pull/12",
            "headRefName": "add-feature", "baseRefName": "main", "mergedAt": "2026-01-01T00:00:00Z",
            "commits": {"totalCount": 3}}]}}}
print(json.dumps({"data": data}))
